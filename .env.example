# Copy this file to ".env" and fill in your Supabase project values.
# Project Settings -> API -> Project URL and anon/public key.
# The portfolio still renders with built-in default content if these are left blank.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: restrict dashboard login to this email only (extra guard on top of Supabase Auth).
# Leave blank to allow any account that exists in your Supabase project.
VITE_OWNER_EMAIL=jiya108gandhi@gmail.com
